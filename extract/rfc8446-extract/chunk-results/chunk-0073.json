                         {
                             "quote":  "Note: TLS defines two generic alerts (see Section 6) to use upon\n   failure to parse a message.  Peers which receive a message which\n   cannot be parsed according to the syntax (e.g., have a length\n   extending beyond the message boundary or contain an out-of-range\n   length) MUST terminate the connection with a \"decode_error\" alert.",
                             "line_start":  4733,
                             "line_end":  4737,
                             "condition":  "a received message cannot be parsed according to the protocol syntax",
                             "required_behavior":  "terminate the connection",
                             "forbidden_behavior":  "",
                             "error_behavior":  "send a decode_error alert",
                             "check_type":  "error_handling",
                             "why_checkable":  "Malformed lengths and boundary violations can drive the required alert branch.",
                             "eligibility":  "eligible"
                         },
                         {
                             "quote":  "Peers which receive a message which is syntactically correct but\n   semantically invalid (e.g., a DHE share of p - 1, or an invalid enum)\n   MUST terminate the connection with an \"illegal_parameter\" alert.",
