    "requirements":  [
                         {
                             "quote":  "TLS provides an Alert content type to indicate closure information\n   and errors.  Like other messages, alert messages are encrypted as\n   specified by the current connection state.",
                             "line_start":  4707,
                             "line_end":  4709,
                             "condition":  "an alert message is transmitted",
                             "required_behavior":  "encrypt it according to the current connection state",
                             "forbidden_behavior":  "",
                             "error_behavior":  "",
                             "check_type":  "state_machine_invariant",
                             "why_checkable":  "Record protection for an Alert can be checked against the active connection epoch.",
                             "eligibility":  "eligible"
                         },
                         {
                             "quote":  "Alert messages convey a description of the alert and a legacy field\n   that conveyed the severity level of the message in previous versions\n   of TLS.  Alerts are divided into two classes: closure alerts and\n   error alerts.  In TLS 1.3, the severity is implicit in the type of\n   alert being sent, and the \"level\" field can safely be ignored.  The\n   \"close_notify\" alert is used to indicate orderly closure of one\n   direction of the connection.  Upon receiving such an alert, the TLS\n   implementation SHOULD indicate end-of-data to the application.",
                             "line_start":  4711,
                             "line_end":  4718,
                             "condition":  "a close_notify alert is received",
                             "required_behavior":  "indicate end-of-data to the application",
                             "forbidden_behavior":  "",
                             "error_behavior":  "",
                             "check_type":  "explicit_normative",
                             "why_checkable":  "The application-facing EOF signal after a received alert is observable.",
                             "eligibility":  "eligible"
                         },
                         {
                             "quote":  "Error alerts indicate abortive closure of the connection (see\n   Section 6.2).  Upon receiving an error alert, the TLS implementation\n   SHOULD indicate an error to the application and MUST NOT allow any\n   further data to be sent or received on the connection.  Servers and",
                             "line_start":  4720,
                             "line_end":  4723,
                             "condition":  "an error alert is received",
                             "required_behavior":  "indicate an error to the application",
                             "forbidden_behavior":  "",
                             "error_behavior":  "",
                             "check_type":  "explicit_normative",
                             "why_checkable":  "The application-facing error signal is observable.",
                             "eligibility":  "eligible"
                         },
                         {
